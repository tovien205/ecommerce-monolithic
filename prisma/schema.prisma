generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Role Model
model Role {
  roleid   String @id
  rolename String
  users    User[]
}

// 2. Membership Model
model Membership {
  mid   String @id
  mname String
  score Int
  users User[]
}

// 3. User Model
model User {
  uid        String      @id
  username   String      @unique
  fullname   String
  password   String
  roleid     String
  mid        String
  role       Role        @relation(fields: [roleid], references: [roleid])
  membership Membership  @relation(fields: [mid], references: [mid])
  orders     Order[]
}

// 4. Product Model
model Product {
  pid          String        @id
  pname        String
  price        Float
  quantity     Int
  orderDetails OrderDetail[]
}

// 5. Order Model
model Order {
  oid          String        @id
  uid          String
  createat     DateTime      @default(now())
  user         User          @relation(fields: [uid], references: [uid])
  orderDetails OrderDetail[]
  shipment     Shipment?
}

// 6. OrderDetail Model (Sử dụng Composite Primary Key: @@id([oid, pid]))
model OrderDetail {
  oid        String
  pid        String
  qty        Int
  unit_price Float
  order      Order   @relation(fields: [oid], references: [oid])
  product    Product @relation(fields: [pid], references: [pid])

  @@id([oid, pid])
}

// 7. Shipment Model
model Shipment {
  shipid String @id
  oid    String @unique
  status String
  order  Order  @relation(fields: [oid], references: [oid])
}